{
  "expo": {
    "name": "DeenTogether",
    "slug": "deen-together",
    "version": "1.0.0",
    "scheme": "deentogether",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deentogether.app"
    },
    "android": {
      "package": "com.deentogether.app",
      "adaptiveIcon": {
        "backgroundColor": "#31523E",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#31523E",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#31523E"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DeenTogether uses your location to calculate accurate prayer times for your area.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0f5238"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0437358b-2ab8-4166-ae11-252c5d1086bd"
      }
    },
    "owner": "ehsanultanjil"
  }
}
